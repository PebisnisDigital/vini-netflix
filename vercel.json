{
  "redirects": [
    { "source": "/payungmadinah", "destination": "/azura", "permanent": true },
    { "source": "/payungmadinah/:path*", "destination": "/azura/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/checkout", "destination": "/checkout/index.html" },
    { "source": "/pesanan", "destination": "/pesanan/index.html" },
    { "source": "/studio", "destination": "/studio/index.html" },
    { "source": "/studio/preview", "destination": "/studio/preview/index.html" },
    { "source": "/mitra", "destination": "/mitra/index.html" },
    { "source": "/formulir", "destination": "/formulir/index.html" },
    { "source": "/HijamaTeam", "destination": "/HijamaTeam/index.html" },
    { "source": "/hijamateam", "destination": "/HijamaTeam/index.html" },
    { "source": "/azura", "destination": "/azura/index.html" },
    { "source": "/azura/", "destination": "/azura/index.html" },
    { "source": "/azura/:section(berita|umroh)/:slug", "destination": "/azura/:section/:slug/index.html" },
    { "source": "/azura/:section(umroh|sosial-media|berita|karir|tentang-kami|kontak|faq|umroh-gratis|doorprizemanasik|cerita-inspiratif|galeri|tanyaumrohhaji|tanyacs|syarat-ketentuan|kebijakan-privasi|visa)", "destination": "/azura/:section/index.html" },
    {
      "source": "/vini",
      "destination": "/vini/index.html"
    },
    {
      "source": "/ElectronicTigerCreativeStudio",
      "destination": "/electronictigercreativestudio/index.html"
    },
    { "source": "/:slug([a-z0-9-]+)", "destination": "/:slug/index.html" }
  ]
}
