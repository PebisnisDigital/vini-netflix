# Mode baru: masukkan di Vercel Project Settings > Environment Variables (Production saja).
# Jangan isi secret di GitHub atau dengan prefix VITE_.
PESONAFLIX_STUDIO_ACCESS_KEY=
PESONAFLIX_STUDIO_SESSION_SECRET=
PESONAFLIX_GITHUB_TOKEN=
# Opsional jika domain berbeda:
# PESONAFLIX_STUDIO_ORIGIN=https://pesonaflix.vercel.app

# Mode lama (opsional, hanya dipakai bila kode Studio belum diaktifkan):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SESSION_SECRET=
GITHUB_ALLOWED_LOGIN=PebisnisDigital
GITHUB_CALLBACK_URL=https://pesonaflix.vercel.app/api/auth/callback
